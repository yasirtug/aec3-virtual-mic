#include <windows.h>

#include "resource.h"

IDI_APP_ICON ICON "../assets/app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION AEC3VM_VERSION_MAJOR, AEC3VM_VERSION_MINOR, AEC3VM_VERSION_PATCH, 0
 PRODUCTVERSION AEC3VM_VERSION_MAJOR, AEC3VM_VERSION_MINOR, AEC3VM_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "AEC3VirtualMic contributors"
      VALUE "FileDescription", "AEC3 Virtual Mic"
      VALUE "FileVersion", AEC3VM_VERSION_STR
      VALUE "InternalName", "AEC3VirtualMic"
      VALUE "LegalCopyright", "Copyright (c) 2026 AEC3VirtualMic contributors. MIT License."
      VALUE "OriginalFilename", "AEC3VirtualMic.exe"
      VALUE "ProductName", "AEC3 Virtual Mic"
      VALUE "ProductVersion", AEC3VM_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
